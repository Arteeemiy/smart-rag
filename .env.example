APP_NAME=smart-rag
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

API_V1_PREFIX=/api/v1

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
REQUEST_TIMEOUT_SECONDS=30
RAG_DEFAULT_MODE=legacy
AGENTIC_RAG_MODEL=gpt-4.1
AGENTIC_RAG_RECURSION_LIMIT=8

MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_API_URL=
MISTRAL_SMALL_MODEL=mistral-small-latest
MISTRAL_MEDIUM_MODEL=mistral-medium-latest

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_SMALL_MODEL=gpt-4o-mini
OPENAI_MEDIUM_MODEL=gpt-4.1

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_SECONDS=1.0
LLM_MAX_RETRY_DELAY_SECONDS=8.0
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_DISABLE_GENERATION_ON_RATE_LIMIT=true

TEST_ENABLE_QUERY_EXPANSION=true
TEST_ENABLE_RERANKING=true
TEST_QUERY_EXPANSION_VARIANTS=1
TEST_RERANK_TOP_N=4
TEST_RERANK_KEEP_N=4

EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

EXPORT_DIR=./artifacts/exports
GOOGLE_SHEETS_CREDENTIALS_FILE=

INDEX_NAME=baseline
CHROMA_PATH=./indexes/baseline/chroma_db
COLLECTION_NAME=knowledge_base
DATA_FILE=./data/sample_documents/sample_documents.json

CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RECREATE_INDEX=false

TOP_K_RESULTS=8
GATE_STRONG=7.0
GATE_MAX=13.0
GAP_MIN=0.9
WINDOW=2.1
MIN_KEEP=2
MAX_KEEP=5

SYSTEM_PROMPT=Ты — технический помощник. Отвечай строго на основе предоставленного контекста. Если ответа в контексте нет — скажи, что информации недостаточно.
